# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# The one exception: placeholder names and no values, so a new checkout knows
# what to fill in. Nothing real ever goes in it.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent tooling (auto-installed by vercel/neon integrations)
.claude/
.agents/
skills-lock.json

# Generated knowledge-graph output — regenerated on demand, not source.
graphify-out/

# Test output.
#
# Unanchored on purpose. A pattern with a slash in the middle is anchored to
# this file's directory, so `/test-results` only ever covered the repo root —
# and Playwright writes into the workspace it runs from, which is
# `apps/web/test-results`. That output was showing up as untracked after every
# run, one directory per failed case, waiting to be committed by accident.
test-results/
playwright-report/
/coverage
.env.local.test

# Generated social post art, run logs and the pause flag. Same anchoring
# problem: these are produced under `apps/web/scripts/social/`, not at the root.
scripts/social/.out/
scripts/social/.log/
scripts/social/.paused
scripts/social/.render-*.html
apps/*/scripts/social/.out/
apps/*/scripts/social/.log/
.turbo/

# Expo's local state. `apps/mobile/.expo` is covered below; this is the copy
# the CLI writes at the workspace root, and `devices.json` in it names the
# machine's own simulators.
/.expo/

# monorepo
node_modules/
.turbo
apps/*/.next
apps/*/.turbo
apps/*/dist
packages/*/dist
# expo
apps/mobile/.expo
apps/mobile/ios
apps/mobile/android

# Generated by `next dev` for AI agents (next.config: agentRules)
apps/*/AGENTS.md
apps/*/CLAUDE.md

# launchd output from the social scheduler — runtime noise, not source
apps/web/scripts/social/.log/

# Agent scratch space — dumps, translation batches, one-off scripts.
.scratch/
.scratch-*
