# Sailo — mail, alerting and scheduled jobs.
#
# Copy to .env.local and fill in. Placeholders only: never commit a real key,
# and never paste one into this file — it is the one env file that IS tracked
# (see the `!.env.example` line in .gitignore).
#
# Not the full set the app reads — DATABASE_URL, the Stripe keys, the auth
# secret and the blob token live in Vercel's project settings and are listed on
# /hq/system, which reports whether each one is present without printing it.

# --- Sending domains --------------------------------------------------------
# Every From address is built from these, and each one must be verified in
# Resend before mail leaves the building.

# The brand domain: the one the website answers on, and the fallback for both
# streams below. Defaults to sailo.store when unset.
SAILO_MAIL_DOMAIN=sailo.store

# Transactional mail — receipts, sign-in links, password resets. The stream
# that must never be filtered.
SAILO_TX_DOMAIN=mail.sailo.store

# Marketing mail — broadcasts and lifecycle campaigns. The stream that earns
# complaints, which is why it belongs on its own domain: a blocklisting here
# must not be able to reach the transactional stream, and on a .store must not
# be able to get the *registered* domain suspended and take the site down.
# Keep this different from SAILO_MAIL_DOMAIN in production.
SAILO_MKT_DOMAIN=send.sailo.email

# --- Mail provider ----------------------------------------------------------

# Resend API key. Without it every send is a no-op that reports itself as
# failed — nothing throws, no order is lost, but no mail goes out either.
#
# Written as a description rather than a realistic-looking dummy: a value that
# keeps the provider's prefix is what secret scanners match on, and a fake one
# raises an alert that costs somebody the same investigation a real leak would.
RESEND_API_KEY=<resend api key, from the Resend dashboard>

# Signing secret for the Resend webhook (/api/resend/webhook): bounces,
# complaints and deliveries. Unsigned deliveries are refused.
RESEND_WEBHOOK_SECRET=<webhook signing secret, shown when you add the endpoint>

# How many broadcast emails may go out in one day, across the whole platform.
# A ceiling on the blast radius of a mistake, not a business limit.
BROADCAST_DAILY_CEILING=5000

# --- Cron -------------------------------------------------------------------

# Vercel sends `Authorization: Bearer $CRON_SECRET` on every scheduled request.
# It is the only credential the cron routes have, and an unset value makes them
# refuse rather than open. Generate with: openssl rand -hex 32
CRON_SECRET=replace-with-a-long-random-string

# --- Staff ------------------------------------------------------------------

# Who can open /hq, and who receives platform alerts — including the daily
# domain-blocklist check. Comma separated; replaces the default roster wholesale.
SAILO_STAFF_EMAILS=admin@sailo.store
