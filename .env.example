# Sailo — mail, alerting, scheduled jobs, and the mobile app's two origins.
#
# Copy to .env.local and fill in. Placeholders only: never commit a real key,
# and never paste one into this file — it is the one env file that IS tracked
# (see the `!.env.example` line in .gitignore).
#
# Not the full set the app reads — DATABASE_URL, the Stripe keys, the auth
# secret and the blob token live in Vercel's project settings and are listed on
# /hq/system, which reports whether each one is present without printing it.

# --- Sending domains --------------------------------------------------------
# Every From address is built from these, and each one must be verified in
# Resend before mail leaves the building.

# The brand domain: the one the website answers on, and the fallback for both
# streams below. Defaults to sailo.store when unset.
SAILO_MAIL_DOMAIN=sailo.store

# Transactional mail — receipts, sign-in links, password resets. The stream
# that must never be filtered.
SAILO_TX_DOMAIN=mail.sailo.store

# Marketing mail — broadcasts and lifecycle campaigns. The stream that earns
# complaints, which is why it belongs on its own domain: a blocklisting here
# must not be able to reach the transactional stream, and on a .store must not
# be able to get the *registered* domain suspended and take the site down.
# Keep this different from SAILO_MAIL_DOMAIN in production.
SAILO_MKT_DOMAIN=send.sailo.email

# --- Mail provider ----------------------------------------------------------

# Resend API key. Without it every send is a no-op that reports itself as
# failed — nothing throws, no order is lost, but no mail goes out either.
#
# Written as a description rather than a realistic-looking dummy: a value that
# keeps the provider's prefix is what secret scanners match on, and a fake one
# raises an alert that costs somebody the same investigation a real leak would.
RESEND_API_KEY=<resend api key, from the Resend dashboard>

# Signing secret for the Resend webhook (/api/resend/webhook): bounces,
# complaints and deliveries. Unsigned deliveries are refused.
RESEND_WEBHOOK_SECRET=<webhook signing secret, shown when you add the endpoint>

# How many broadcast emails may go out in one day, across the whole platform.
# A ceiling on the blast radius of a mistake, not a business limit.
BROADCAST_DAILY_CEILING=5000

# --- Cron -------------------------------------------------------------------

# Vercel sends `Authorization: Bearer $CRON_SECRET` on every scheduled request.
# It is the only credential the cron routes have, and an unset value makes them
# refuse rather than open. Generate with: openssl rand -hex 32
CRON_SECRET=replace-with-a-long-random-string

# --- Staff ------------------------------------------------------------------

# Who can open /hq, and who receives platform alerts — including the daily
# domain-blocklist check. Comma separated; replaces the default roster wholesale.
SAILO_STAFF_EMAILS=admin@sailo.store

# --- Mobile -----------------------------------------------------------------
# Read by apps/mobile, and the only variables there that are. `EXPO_PUBLIC_`
# is not a naming convention — it is the prefix Expo uses to decide what gets
# inlined into the JavaScript bundle, so anything named this way ships to the
# device and is readable by anyone holding the app. Both of these are origins,
# which is why that is fine; nothing secret may ever wear this prefix.
#
# Set for real builds in apps/mobile/eas.json, per build profile. Set them here
# only to override a local `expo start` — a value here does not reach an EAS
# build.
#
# Every profile there names both explicitly rather than leaning on the code's
# defaults, so repointing a build at a staging origin is one obvious edit rather
# than a fallback buried in apps/mobile/lib/api.ts. They resolve to different
# hosts in every environment today.

# The data origin: apps/api, which serves /api/trpc. Defaults to
# https://api.sailo.store when unset. Point it at http://localhost:3002 to work
# against `pnpm --filter @sailo/api-server dev`.
EXPO_PUBLIC_API_URL=https://api.sailo.store

# The auth origin: apps/web, which mints sessions and is the only thing that
# can. Deliberately a second variable rather than a path on the first — apps/api
# carries a verify-only better-auth instance with no sign-in route, so pointing
# this at the API origin reaches a server that cannot answer. Defaults to
# https://sailo.store when unset; http://localhost:3000 for a local `next dev`.
EXPO_PUBLIC_AUTH_URL=https://sailo.store

# Where a crash on a seller's phone goes. Unset — including here — keeps the
# console sink, which is what local dev and CI want: `startSentry` returns null
# and `@sailo/observability` falls back rather than silently discarding.
#
# Note that `@sentry/react-native` is a native module, so the app needs a
# development build (`npx expo run:ios`) rather than Expo Go once this is on.
# Production builds are EAS builds anyway, so the cost is a local-dev one.
EXPO_PUBLIC_SENTRY_DSN=

# The same, for the two servers — apps/web and apps/api both install
# `@sailo/observability/web` at boot from their `instrumentation.ts`.
#
# Until this is set, a thrown Server Component, Route Handler or Server Action
# is a line in a Vercel log and nothing more. That was the state of things
# while the phone already had a real reporter, which is the wrong way round:
# these are the two servers that take every payment.
#
# Separate from the phone's DSN on purpose. They are different platforms with
# different release identifiers — a native stack trace is read against an
# `expo-updates` runtime version, a server one against a git sha — and a single
# project that mixes them makes both harder to read.
#
# Unset keeps the console sink, so nothing here is required to run or deploy.
SENTRY_DSN=
