{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/i18n/*.mts"
      ],
      "project": [
        "scripts/**/*.mts"
      ]
    },
    "apps/web": {
      "entry": [
        "e2e/**/*.spec.ts",
        "e2e/**/*.scenario.ts",
        "e2e/scenarios/*.{ts,mts}",
        "e2e/stubs/*.{ts,mts}",
        "scripts/**/*.ts",
        "sw.mjs"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "src/**/*.css",
        "scripts/**/*.ts",
        "e2e/**/*.ts"
      ],
      "ignoreDependencies": [
        "@vitejs/plugin-react",
        "dotenv"
      ],
      "drizzle": {
        "config": [
          "drizzle.config.ts"
        ]
      }
    },
    "apps/api": {
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "apps/docs": {
      "entry": [
        "src/mdx-components.tsx"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "apps/hq": {
      "entry": [
        "e2e/**/*.scenario.ts",
        "e2e/scenarios/*.{ts,mts}",
        "test-stubs/*.{ts,mts}"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "src/**/*.css",
        "e2e/**/*.ts",
        "test-stubs/*.ts"
      ]
    },
    "apps/mobile": {
      "entry": [
        "app/**/*.{ts,tsx}",
        "lib/**/*.ts"
      ],
      "project": [
        "app/**/*.{ts,tsx}",
        "lib/**/*.ts"
      ],
      "ignoreDependencies": [
        "expo-network",
        "canvaskit-wasm"
      ],
      "ignoreUnresolved": [
        "./jest/skia-env.js"
      ]
    },
    "packages/*": {
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "packages/email": {
      "entry": [
        "src/testing/*.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "packages/events": {
      "project": [
        "src/**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "redis"
      ]
    },
    "packages/i18n": {
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "packages/config": {
      "entry": [],
      "project": []
    }
  },
  "exclude": [
    "optionalPeerDependencies"
  ],
  "ignoreExportsUsedInFile": true
}
