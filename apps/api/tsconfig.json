{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@sailo/config/tsconfig.base.json",
  "compilerOptions": {
    /*
     * The base config targets a plain Node/bundler library. A Next app needs
     * three things on top of it, and nothing else: the DOM lib (Request,
     * Response, Headers — the whole Route Handler surface), JSX left alone for
     * Next to compile, and the `next` language-service plugin.
     */
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "moduleDetection": "force",
    "allowJs": true,
    "incremental": true,
    "noEmit": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
