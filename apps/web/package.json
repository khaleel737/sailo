{
  "name": "@sailo/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "test": "vitest run",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
    "db:partition": "dotenv -e .env.local -- tsx scripts/partition-visits.ts",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "db:seed": "dotenv -e .env.local -- tsx scripts/seed.ts",
    "db:seed:niches": "dotenv -e .env.local -- tsx scripts/seed-niches.ts",
    "db:seed:demos": "dotenv -e .env.local -- tsx scripts/seed-demos.ts",
    "comp": "dotenv -e .env.local -- tsx scripts/comp-plan.ts",
    "check:i18n": "tsx scripts/check-i18n.ts",
    "check:connect": "dotenv -e .env.local -- tsx scripts/check-connect.ts",
    "check:rails": "dotenv -e .env.local -- tsx scripts/check-rails.ts",
    "check:cards": "dotenv -e .env.local -- tsx scripts/check-cards.ts",
    "check:stores": "dotenv -e .env.local -- tsx scripts/check-stores.ts",
    "check:methods": "dotenv -e .env.local -- tsx scripts/check-payment-methods.ts",
