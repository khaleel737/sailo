    "check:connect:live": "tsx scripts/check-connect-live.ts",
    "check:webhooks": "bash scripts/check-webhooks.sh",
    "shots": "tsx scripts/shots.ts",
    "covers": "tsx scripts/social-covers/render.ts",
    "check:load": "dotenv -e .env.local -- tsx scripts/check-load.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "next typegen && tsc --noEmit",
    "lint:fix": "oxlint --fix",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "check:partners": "dotenv -e .env.local -- tsx scripts/check-partners.ts",
