{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "e2e/**/*.spec.ts",
    "e2e/stubs/*.{ts,mts}",
    "scripts/**/*.ts",
    "sw.mjs"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.ts", "e2e/**/*.ts"],
  "ignoreExportsUsedInFile": true,
  "ignore": ["src/i18n/**"],
  "ignoreDependencies": ["@vitejs/plugin-react", "tailwindcss", "dotenv"],
  "drizzle": {
    "config": ["drizzle.config.ts"]
  }
}
