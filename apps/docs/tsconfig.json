{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@sailo/config/tsconfig.base.json",
  "compilerOptions": {
    /*
     * The same three additions apps/api and apps/hq make to the shared base:
     * the DOM lib, JSX left for Next to compile, and the `next` language
     * service plugin.
     */
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "moduleDetection": "force",
    "allowJs": true,
    "incremental": true,
    "noEmit": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
