{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.sailo.store",
        "EXPO_PUBLIC_AUTH_URL": "https://sailo.store"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.sailo.store",
        "EXPO_PUBLIC_AUTH_URL": "https://sailo.store"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.sailo.store",
        "EXPO_PUBLIC_AUTH_URL": "https://sailo.store"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "REPLACE_BEFORE_FIRST_SUBMIT",
        "appleTeamId": "REPLACE_BEFORE_FIRST_SUBMIT",
        "bundleIdentifier": "store.sailo.app",
        "sku": "store.sailo.app",
        "language": "en-US",
        "companyName": "Khaleel Musleh",
        "metadataPath": "./store.config.json"
      },
      "android": {
        "applicationId": "store.sailo.app",
        "track": "internal",
        "releaseStatus": "completed",
        "changesNotSentForReview": false
      }
    },
    "beta": {
      "extends": "production",
      "android": {
        "applicationId": "store.sailo.app",
        "track": "beta",
        "releaseStatus": "completed",
        "changesNotSentForReview": false
      }
    },
    "rollout": {
      "extends": "production",
      "android": {
        "applicationId": "store.sailo.app",
        "track": "production",
        "releaseStatus": "inProgress",
        "rollout": 0.1,
        "changesNotSentForReview": false
      }
    }
  }
}
