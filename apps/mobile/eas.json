{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.sailo.store",
        "EXPO_PUBLIC_AUTH_URL": "https://sailo.store"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.sailo.store",
        "EXPO_PUBLIC_AUTH_URL": "https://sailo.store"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.sailo.store",
        "EXPO_PUBLIC_AUTH_URL": "https://sailo.store"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
