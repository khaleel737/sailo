{
  "extends": "@sailo/config/tsconfig.hermes.json",
  /*
   * `react-jsx` rather than `preserve`, so the components typecheck as the
   * runtime will actually see them.
   *
   * Relative imports here are extensionless on purpose, unlike `@sailo/tokens`.
   * This package is consumed as source: apps/mobile typechecks straight through
   * `src/index.ts`, so an import ending in `.tsx` would demand
   * `allowImportingTsExtensions` in every consumer's tsconfig rather than only
   * in this one.
   */
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    // `es2022` from the Hermes config, re-stated because `dom` has to be added
    // to it rather than beside it — `lib` replaces, it does not merge.
    "lib": ["es2022", "dom"]
  },
  "include": ["src"]
}
