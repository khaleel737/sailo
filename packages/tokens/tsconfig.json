{
  "extends": "@sailo/config/tsconfig.base.json",
  /*
   * `allowImportingTsExtensions` because `src/generate.ts` is run by Node
   * directly, under its own type stripping, rather than through a bundler or a
   * runner nobody else in this repo installs. Node's ESM resolver wants the
   * real filename, so the relative imports in this package carry `.ts` — which
   * tsc only accepts with this on, and which is only safe because `noEmit`
   * means nothing here is ever compiled to a `.js` that would need rewriting.
   */
  "compilerOptions": { "noEmit": true, "allowImportingTsExtensions": true },
  "include": ["src"]
}
